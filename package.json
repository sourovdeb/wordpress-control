{
  "name": "wp-ai-studio",
  "displayName": "WP AI Studio",
  "description": "Control your WordPress site with AI — DeepSeek, Anthropic, Ollama",
  "version": "1.1.0",
  "publisher": "sourovdeb",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "wpai.openPanel",    "title": "WP AI: Open Studio"       },
      { "command": "wpai.generatePost", "title": "WP AI: Generate Post"     },
      { "command": "wpai.siteStatus",   "title": "WP AI: Check Site Status" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "wp-ai-studio", "title": "WP AI Studio", "icon": "icon.svg" }]
    },
    "configuration": {
      "title": "WP AI Studio",
      "properties": {
        "wpai.wordpressUrl":  { "type": "string",  "default": "",                       "description": "Your WordPress site URL" },
        "wpai.wpUser":        { "type": "string",  "default": "",                       "description": "WordPress username or email" },
        "wpai.wpAppPassword": { "type": "string",  "default": "",                       "description": "WordPress Application Password" },
        "wpai.pluginKey":     { "type": "string",  "default": "",                       "description": "Plugin secret key (X-Sourov-Key)" },
        "wpai.aiProvider":    { "type": "string",  "default": "deepseek",               "description": "AI provider: deepseek | anthropic | ollama" },
        "wpai.anthropicKey":  { "type": "string",  "default": "",                       "description": "Anthropic API key (sk-ant-...)" },
        "wpai.deepseekKey":   { "type": "string",  "default": "",                       "description": "DeepSeek API key (sk-...)" },
        "wpai.ollamaUrl":     { "type": "string",  "default": "http://localhost:11434", "description": "Ollama server URL" },
        "wpai.ollamaModel":   { "type": "string",  "default": "llama3",                 "description": "Ollama model name" },
        "wpai.approvalMode":  { "type": "boolean", "default": true,                     "description": "Review AI output before posting" },
        "wpai.defaultStatus": { "type": "string",  "default": "draft",                  "description": "Default post status: draft | publish" }
      }
    }
  },
  "dependencies": { "node-fetch": "^3.3.2" }
}

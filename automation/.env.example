# ── WordPress ────────────────────────────────────────────────
WP_URL=https://yourblog.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── DeepSeek ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat          # or deepseek-reasoner

# ── Scheduling defaults ───────────────────────────────────────
# Comma-separated weekdays: 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri
PUBLISH_DAYS=1,3                      # Tue & Thu
PUBLISH_HOUR=9                        # 9 AM site timezone
MIN_GAP_HOURS=48                      # Min hours between posts

# ── SEO plugin ───────────────────────────────────────────────
# Options: yoast | rankmath | aioseo | none
SEO_PLUGIN=yoast

# ── Optional: Google Sheets queue ────────────────────────────
# GSHEET_CREDENTIALS_JSON=credentials.json
# GSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# GSHEET_SHEET_NAME=Queue

# ── Optional: featured image generation ──────────────────────
# AUTO_FEATURED_IMAGE=false
